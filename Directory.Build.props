<Project>
  <PropertyGroup>
    <ValheimPath Condition="'$(ValheimPath)' == '' AND '$(VALHEIM_PATH)' != ''">$(VALHEIM_PATH)</ValheimPath>
    <ValheimPath Condition="'$(ValheimPath)' == ''">D:\valheim-ref</ValheimPath>
    <ValheimManaged>$(ValheimPath)\valheim_Data\Managed</ValheimManaged>
    <ValheimPublicized>$(ValheimManaged)\publicized_assemblies</ValheimPublicized>
    <BepInExCore>$(ValheimPath)\BepInEx\core</BepInExCore>
  </PropertyGroup>
</Project>
